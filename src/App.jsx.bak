}`}
>

{/* Sidebar */}
<div className="w-full lg:w-60 bg-gradient-to-b from-slate-950 via-slate-900 to-blue-950 text-white p-5 shadow-2xl flex flex-col">
<div className="mb-10 text-center">

<h1 className="text-3xl font-extrabold tracking-tight leading-tight text-white">
  ⚙ Workshop Tracker
</h1>

<p className="text-xs text-slate-400 mt-2">
  Workshop Management System
</p>

</div>
<div className="border-b border-slate-800 mb-6"></div>
<ul className="space-y-3">

<li
  onClick={() => setActiveMenu("Dashboard")}
  className={`flex items-center gap-3 px-4 h-12 rounded-2xl cursor-pointer transition-all duration-300 font-semibold ${
    activeMenu === "Dashboard"
      ? "bg-gradient-to-r from-blue-600 to-indigo-700 shadow-lg shadow-blue-900/30"
      : "hover:bg-slate-800 hover:translate-x-1"
  }`}
>
  <LayoutDashboard size={20} />
  Dashboard
</li>

{role === "admin" && (
<li
  onClick={() => setActiveMenu("Equipment")}
  className={`flex items-center gap-3 px-4 h-12 rounded-2xl cursor-pointer transition-all duration-300 font-semibold ${
    activeMenu === "Equipment"
      ? "bg-gradient-to-r from-blue-600 to-indigo-700 shadow-lg shadow-blue-900/30"
      : "hover:bg-slate-800 hover:translate-x-1"
  }`}
>
  <Package size={20} />
  Equipment
</li>
