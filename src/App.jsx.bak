<tr
  key={index}
  className={`border-b transition duration-300 hover:bg-slate-100/50 ${
    darkMode
      ? "border-slate-700 hover:bg-slate-700/30"
      : "border-slate-200"
  }`}
>

<td className="py-4 px-3 font-semibold">
  {pump.type}
</td>

<td className="text-center py-4 px-3 font-bold">

