</label>

<select

  value={currentBay}

  onChange={(e) =>
    setCurrentBay(
      e.target.value
    )
  }

  className="w-full h-12 px-4 rounded-xl border mt-2 text-black"
>

{bayList.map(
  (bay, index) => (

    <option
      key={index}
      value={bay}
    >

