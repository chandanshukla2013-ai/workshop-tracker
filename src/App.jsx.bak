<select

  value={equipmentCategory}

  onChange={(e) => {

    setEquipmentCategory(
      e.target.value
    );

    setEquipmentType("");

  }}

  className="w-full h-12 px-4 rounded-xl border mt-2 text-black"
>

<option value="">
  Select Category
</option>

{equipmentCategories.map(
  (category, index) => (

