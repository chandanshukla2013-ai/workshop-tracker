darkMode ? "text-slate-300" : "text-slate-600"
}`}>
  Status
</label>

<select

  value={status}

  onChange={(e) => {

    setStatus(
      e.target.value
    );

    // Auto bay update

    if (
      e.target.value ===
      "Completed"
    ) {

      setCurrentBay(
        "Finished Bay"
      );

    }

    else if (
      e.target.value ===
      "Overhauling"
    ) {

      setCurrentBay(
        "Overhauling Bay"
      );

    }

  }}

  className="w-full h-12 px-4 rounded-xl border mt-2 text-black"
>

{statusList.map(
  (statusItem, index) => (

    <option
      key={index}
      value={statusItem}
    >

      {statusItem}

    </option>

  )
)}

</select>

</div>

