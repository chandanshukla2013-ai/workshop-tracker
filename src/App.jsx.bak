</td>

<td className="text-center py-4 px-3 text-blue-600 font-bold">
  {pump.receivedBay}
</td>

<td className="text-center py-4 px-3 text-orange-500 font-bold">
  {pump.overhaulingBay}
</td>

<td className="text-center py-4 px-3 text-green-600 font-bold">
  {pump.finishedBay}
</td>

<td className="text-center py-4 px-3 font-bold text-indigo-600">

  {pump.availableQty}

</td>

<td className="text-center py-4 px-3">

{pump.alert ? (

<span className="bg-red-500 text-white px-3 py-1 rounded-xl text-sm font-bold">
